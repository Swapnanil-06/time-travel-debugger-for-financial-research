{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financial-research-project",
  "main": "build/worker/worker.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["python_workers"],
  "find_additional_modules": true,
  "build": {
    "command": "python scripts/prepare_worker.py",
    "watch_dir": ["app", "worker.py", "scripts", "requirements-cloudflare.txt"]
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "ResearchWorkspace" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ResearchWorkspace"] }
  ],
  "observability": { "enabled": true }
}
